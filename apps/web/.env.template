# Medusa backend URL
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key — create one in the Medusa admin under Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Storefront URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Default region ISO-2 code (used when country cannot be detected)
NEXT_PUBLIC_DEFAULT_REGION=eu

# Next.js on-demand revalidation secret — use any random string
REVALIDATE_SECRET=supersecret

# Stripe — optional, required for Stripe payment provider
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Payments — optional, required for Medusa Payments provider
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Medusa Cloud S3 — optional, for image optimization on Medusa Cloud
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
