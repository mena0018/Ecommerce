{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "env": [
        "MEDUSA_BACKEND_URL",
        "MEDUSA_CLOUD_S3_HOSTNAME",
        "MEDUSA_CLOUD_S3_PATHNAME",
        "REVALIDATE_SECRET",
        "NEXT_PUBLIC_*"
      ],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
