{
  "name": "ecommerce",
  "version": "0.0.1",
  "description": "Menad Rabie's website",
  "author": "Menad Rabie <rabie.menad.dev@gmail.com>",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@apps/api",
    "build:web": "turbo run build --filter=@apps/web",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@apps/api",
    "dev:web": "turbo run dev --filter=@apps/web",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@apps/web",
    "format": "prettier --write .",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "turbo run typecheck --filter=@apps/api",
    "typecheck:web": "turbo run typecheck --filter=@apps/web",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:cache": "turbo daemon clean"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.3",
      "@types/react-dom": "^19.2.3"
    },
    "ignoredBuiltDependencies": [
      "@medusajs/telemetry"
    ],
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.7.3",
    "typescript": "5.9.3"
  }
}
